---
layout: base.njk
title: Team
permalink: /team/
description: Cornerstone Family Care | Team
---

<main id="main">
  
  <div>
    <img src="/static/img/team-photo.png" class="mx-auto" />
  </div>

  <div class="container">

    <article>

      <div id="primary-team-members" class="lg:grid lg:grid-cols-2 lg:gap-12">
        {% for member in team.primary %}
        <div class="team-member flex flex-col justify-between">
          <div>
            <img class="rounded-t-4xl" src="{{ member.image }}" alt="{{ member.name }}">
            <h3>
              <span>{{ member.name }}</span>
              <small class="block text-sm font-sans font-normal opacity-90 mt-1">{{ member.title }}</small>
            </h3>
            
            <div class="space-y-3 text-sm px-1 mb-4 text-oxley-900">
              {% if member.populations %}
              <div>
                <strong class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-0.5">Populations Served</strong>
                <p class="text-gray-700">{{ member.populations }}</p>
              </div>
              {% endif %}
              {% if member.services %}
              <div>
                <strong class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-0.5">Services Provided</strong>
                <p class="text-gray-700">{{ member.services }}</p>
              </div>
              {% endif %}
            </div>
          </div>
          
          {% if member.bio and member.bio.length > 0 %}
          <button @click="modalOpen = !modalOpen, modalMember = '{{ member.id }}'" class="flex items-center justify-center">
            Read More
          </button>
          {% endif %}
        </div>
        {% endfor %}
      </div> <!-- primary-team-members -->
      
      <div id="all-team-members" class="md:grid md:grid-cols-2 md:gap-8 lg:grid-cols-3 lg:gap-8">
        {% for member in team.members %}
        <div class="team-member flex flex-col justify-between">
          <div>
            <img class="rounded-t-4xl" src="{{ member.image }}" alt="{{ member.name }}">
            <h3>
              <span>{{ member.name }}</span>
              <small class="block text-sm font-sans font-normal opacity-90 mt-1">{{ member.title }}</small>
            </h3>
            
            <div class="space-y-3 text-sm px-1 mb-4 text-oxley-900">
              {% if member.populations %}
              <div>
                <strong class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-0.5">Populations Served</strong>
                <p class="text-gray-700">{{ member.populations }}</p>
              </div>
              {% endif %}
              {% if member.services %}
              <div>
                <strong class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-0.5">Services Provided</strong>
                <p class="text-gray-700">{{ member.services }}</p>
              </div>
              {% endif %}
              {% if member.supervisor %}
              <div>
                <strong class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-0.5">Supervisor</strong>
                <p class="text-gray-700">{{ member.supervisor }}</p>
              </div>
              {% endif %}
            </div>
          </div>
          
          {% if member.bio and member.bio.length > 0 %}
          <button @click="modalOpen = !modalOpen, modalMember = '{{ member.id }}'" class="flex items-center justify-center">
            Read More
          </button>
          {% endif %}
        </div>
        {% endfor %}
      </div> <!-- all-team-members -->
      
    </article>

  </div> <!-- container -->

</main>

{% include "modal.njk" %}

{% for member in team.all %}
{% if member.bio and member.bio.length > 0 %}
<div x-show="modalMember == '{{ member.id }}'" class="mt-4 space-y-6">
  <!-- Bio Narrative -->
  <div class="space-y-4 text-base leading-relaxed text-gray-700">
    <h4 class="font-serif text-lg font-semibold text-oxley-800 border-b border-oxley-100 pb-1">About {{ member.short_name or member.name }}</h4>
    {% for paragraph in member.bio %}
    <p>{{ paragraph | safe }}</p>
    {% endfor %}
  </div>

  <!-- Structured Profile Details -->
  {% if member.populations or member.services or member.areas_of_focus or member.education or member.membership or member.specialized_training or member.therapy_toolkit or member.supervisor %}
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 bg-oxley-50/70 rounded-lg border border-oxley-200/60 text-sm">
    {% if member.populations %}
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Populations Served</span>
      <p class="text-oxley-900 leading-snug">{{ member.populations }}</p>
    </div>
    {% endif %}
    {% if member.services %}
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Services Provided</span>
      <p class="text-oxley-900 leading-snug">{{ member.services }}</p>
    </div>
    {% endif %}
    {% if member.supervisor %}
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Supervisor</span>
      <p class="text-oxley-900 leading-snug">{{ member.supervisor }}</p>
    </div>
    {% endif %}
    {% if member.areas_of_focus %}
    <div class="sm:col-span-2">
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Areas of Focus</span>
      <p class="text-oxley-900 leading-snug">{{ member.areas_of_focus }}</p>
    </div>
    {% endif %}
    {% if member.education %}
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Education</span>
      <p class="text-oxley-900 leading-snug">{{ member.education }}</p>
    </div>
    {% endif %}
    {% if member.membership %}
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Membership</span>
      <p class="text-oxley-900 leading-snug">{{ member.membership }}</p>
    </div>
    {% endif %}
    {% if member.specialized_training %}
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Specialized Training</span>
      <p class="text-oxley-900 leading-snug">{{ member.specialized_training }}</p>
    </div>
    {% endif %}
    {% if member.therapy_toolkit %}
    <div>
      <span class="block text-xs font-bold uppercase tracking-wider text-ochre-700 mb-1">Therapy Toolkit</span>
      <p class="text-oxley-900 leading-snug">{{ member.therapy_toolkit }}</p>
    </div>
    {% endif %}
  </div>
  {% endif %}
</div>
{% endif %}
{% endfor %}